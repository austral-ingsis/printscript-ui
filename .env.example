VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
# Auth0 API identifier, so the access token is a JWT that snippet-service can validate
VITE_AUTH0_AUDIENCE=
# Base URL of snippet-service as seen by the browser (default: /api, same origin)
VITE_BACKEND_URL=
# Dev server only: where Vite proxies /api to (default: http://localhost:8080)
SNIPPET_SERVICE_URL=
